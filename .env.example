# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=english_coach
DB_USER=coach_user
DB_PASSWORD=coach_pass

# ─── Docker root password (docker-compose.yml) ──────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=english_coach
MYSQL_USER=coach_user
MYSQL_PASSWORD=coach_pass

# ─── Application ─────────────────────────────────────────────────────────────
DEBUG=True
CORS_ORIGINS=["http://localhost:4200"]

# ─── Speech To Text (Whisper) ────────────────────────────────────────────────
# Use English-only models (e.g., base.en, small.en) for standard native speech.
# Use Multilingual models (e.g., base, small) for non-native / Hispanic accent robustness.
WHISPER_MODEL=small

# ─── AI Coach (Ollama) ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
